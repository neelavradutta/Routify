# Sign JWTs with a long random string in anything other than local development.
JWT_SECRET=replace-me-with-a-long-random-string

# Optional. Without a key the "why this route" panel falls back to deterministic wording.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

PORT=4000
# Optional. Your Vercel URL once the frontend is live (also accepts *.vercel.app automatically).
WEB_ORIGIN=http://localhost:3000
